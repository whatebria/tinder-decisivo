# Copia este archivo a .env y edita los valores para tu entorno local.
# NUNCA commitear el .env real.

# ------------------------------------------------------------
# Django core
# ------------------------------------------------------------
# Obligatorio en produccion. Generar con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambiar-esto-por-una-clave-random-de-al-menos-50-chars

# 'True' o 'False' (default: False). En prod SIEMPRE False.
DEBUG=True

# Lista separada por comas, sin espacios.
ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2

# ------------------------------------------------------------
# Base de datos
# ------------------------------------------------------------
# Default: SQLite local (comodo para dev/tests). Deja esta variable vacia
# o comentada para usar SQLite. Para produccion, apunta a Postgres:
#   DATABASE_URL=postgres://user:password@host:5432/dbname
#   DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# Otros drivers soportados por dj-database-url: mysql://, sqlite:///, etc.
# DATABASE_URL=

# ------------------------------------------------------------
# CORS (Expo web / navegador; para React Native nativo no hace falta)
# ------------------------------------------------------------
# Lista explicita separada por comas. NUNCA se abre a "*" (ni en dev).
CORS_ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081

# Alternativa por regex para puertos dinamicos de Expo (opcional).
# CORS_ALLOWED_ORIGIN_REGEXES=^http://localhost:\d+$

# ------------------------------------------------------------
# Auth
# ------------------------------------------------------------
# Dias que dura un token de auth antes de forzar re-login.
# Recomendado: 7 dias (F3 security review). 30 dias es demasiado para datos electorales.
# Fix completo: refresh-token flow (pendiente, TASK-003).
TOKEN_TTL_DAYS=7

# ------------------------------------------------------------
# Zona horaria y idioma (Chile por default)
# ------------------------------------------------------------
TIME_ZONE=America/Santiago
LANGUAGE_CODE=es-cl

# ------------------------------------------------------------
# Email (para password reset)
# ------------------------------------------------------------
# Dev: console backend imprime el email al stdout (util para testing).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Prod: SMTP
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu-cuenta@gmail.com
# EMAIL_HOST_PASSWORD=app-password
DEFAULT_FROM_EMAIL=no-reply@tinder-decisivo.cl
PASSWORD_RESET_URL_BASE=http://localhost:8081/reset-password

# ------------------------------------------------------------
# Hardening prod (solo aplica si DEBUG=False; comentar para override)
# ------------------------------------------------------------
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
