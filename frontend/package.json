{
  "name": "frontend",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.18.1",
    "expo": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.26.2",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.4",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "types:gen": "cd ../backend && uv run python manage.py spectacular --file ../frontend/schema.yml && cd ../frontend && openapi-typescript schema.yml -o src/types/api.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "catalog:generate": "node scripts/generate-catalog.js",
    "catalog:generate:strict": "node scripts/generate-catalog.js --strict",
    "catalog:verify-props": "node scripts/verify-props.js",
    "catalog:check": "node scripts/generate-catalog.js --strict && node scripts/verify-props.js",
    "test:catalog": "jest --testPathPattern=\"(catalog-completeness|props-diff)\""
  },
  "private": true
}
